---
import { getLocaleFromUrl, localePath, switchLocalePath, useTranslations } from '@/i18n/utils';
import { locales } from '@/i18n/ui';
import { SITE_CONFIG } from '@/config';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const navItems = [
  { href: localePath(locale, '/'), label: t('nav.home') },
  { href: localePath(locale, '/projects'), label: t('nav.projects') },
  ...(SITE_CONFIG.blogEnabled ? [{ href: localePath(locale, '/blog'), label: t('nav.blog') }] : []),
  { href: localePath(locale, '/cv'), label: t('nav.cv') },
];

function isActive(href: string): boolean {
  const current = Astro.url.pathname.replace(/\/$/, '') || '/';
  const target = href.replace(/\/$/, '') || '/';
  if (target === `/${locale}`) return current === target;
  return current.startsWith(target);
}

const initials = SITE_CONFIG.name
  .split(' ')
  .map((p) => p[0])
  .join('');
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-surface-600/30 bg-surface-950/70 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5">
    <a
      href={localePath(locale, '/')}
      class="font-mono text-lg font-bold tracking-tight text-ink-100"
      aria-label={t('nav.home')}
    >
      <span class="text-gradient">{initials}</span><span class="text-accent-400">_</span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2" aria-label="Main">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-2.5 py-1.5 text-sm transition-colors sm:px-3',
              isActive(item.href)
                ? 'bg-surface-800 text-ink-100'
                : 'text-ink-500 hover:bg-surface-800/60 hover:text-ink-100',
            ]}
          >
            {item.label}
          </a>
        ))
      }

      <div
        class="ml-2 flex items-center gap-0.5 rounded-lg border border-surface-600/40 p-0.5 font-mono text-xs"
        aria-label={t('nav.language')}
      >
        {
          locales.map((l) => (
            <a
              href={switchLocalePath(Astro.url, l)}
              aria-current={l === locale ? 'true' : undefined}
              class:list={[
                'rounded-md px-2 py-1 uppercase transition-colors',
                l === locale
                  ? 'bg-accent-500/15 text-accent-300'
                  : 'text-ink-500 hover:text-ink-100',
              ]}
            >
              {l}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>
