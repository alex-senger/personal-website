---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations } from '@/i18n/utils';

// Served by nginx for any unknown path; language is unknown at this point,
// so show both.
const tEn = useTranslations('en');
const tDe = useTranslations('de');
---

<BaseLayout title="404">
  <div class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center px-5 text-center">
    <p class="text-gradient font-mono text-8xl font-bold">404</p>
    <h1 class="mt-6 text-2xl font-bold text-ink-100">
      {tEn('notFound.title')} · {tDe('notFound.title')}
    </h1>
    <p class="mt-3 text-ink-500">{tEn('notFound.text')}</p>
    <p class="text-ink-500">{tDe('notFound.text')}</p>
    <div class="mt-8 flex gap-4 font-mono text-sm">
      <a href="/en/" class="text-accent-400 hover:text-accent-300">→ {tEn('notFound.back')}</a>
      <a href="/de/" class="text-accent-400 hover:text-accent-300">→ {tDe('notFound.back')}</a>
    </div>
  </div>
</BaseLayout>
